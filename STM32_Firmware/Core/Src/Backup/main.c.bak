/* USER CODE BEGIN 4 */
static void Main_Require(BaseType_t result)
{
  if (result != pdPASS)
  {
    Error_Handler();
  }
}

static void Main_RequirePtr(const void *pointer)
{
  if (pointer == NULL)
  {
    Error_Handler();
  }
}

static void Main_CreateRtosObjects(void)
{
  uint8_t i;

  sensorQueue = xQueueCreate(SENSOR_QUEUE_LENGTH, sizeof(sensor_message_t));
  displayQueue = xQueueCreate(DISPLAY_QUEUE_LENGTH, sizeof(display_message_t));
  lcdMutex = xSemaphoreCreateMutex();
  sampleSem = xSemaphoreCreateBinary();
  appEvents = xEventGroupCreate();

  Main_RequirePtr(sensorQueue);
  Main_RequirePtr(displayQueue);
  Main_RequirePtr(lcdMutex);
  Main_RequirePtr(sampleSem);
  Main_RequirePtr(appEvents);

  for (i = 0U; i < SENSOR_COUNT; i++)
  {
    echoSem[i] = xSemaphoreCreateBinary();
    Main_RequirePtr(echoSem[i]);
  }

  sampleTimer = xTimerCreate("sample",
                             pdMS_TO_TICKS(SENSOR_SAMPLE_PERIOD_MS),
                             pdTRUE,
                             NULL,
                             SampleTimerCallback);
  alertTimer = xTimerCreate("alert",
                            pdMS_TO_TICKS(ALERT_REFRESH_PERIOD_MS),
                            pdTRUE,
                            NULL,
                            AlertTimerCallback);
  Main_RequirePtr(sampleTimer);
  Main_RequirePtr(alertTimer);
  Main_Require(xTimerStart(sampleTimer, 0U));
  Main_Require(xTimerStart(alertTimer, 0U));
}

static void Main_CreateTasks(void)
{
  Main_Require(xTaskCreate(SensorTask,
                           "Sensor",
                           SENSOR_TASK_STACK_SIZE,
                           NULL,
                           SENSOR_TASK_PRIORITY,
                           NULL));
  Main_Require(xTaskCreate(WarningTask,
                           "Warning",
                           WARNING_TASK_STACK_SIZE,
                           NULL,
                           WARNING_TASK_PRIORITY,
                           NULL));
  Main_Require(xTaskCreate(DisplayTask,
                           "Display",
                           DISPLAY_TASK_STACK_SIZE,
                           NULL,
                           DISPLAY_TASK_PRIORITY,
                           NULL));
}

static void DelayCounter_Init(void)
{
  cpuTicksPerUs = HAL_RCC_GetHCLKFreq() / 1000000U;

  CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
  DWT->CYCCNT = 0U;
  DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
}

static uint32_t GetMicroseconds(void)
{
  if (cpuTicksPerUs == 0U)
  {
    DelayCounter_Init();
  }

  return DWT->CYCCNT / cpuTicksPerUs;
}

static void DelayUs(uint32_t microseconds)
{
  uint32_t start_tick;
  uint32_t wait_tick;

  if (cpuTicksPerUs == 0U)
  {
    DelayCounter_Init();
  }

  start_tick = DWT->CYCCNT;
  wait_tick = microseconds * cpuTicksPerUs;

  while ((DWT->CYCCNT - start_tick) < wait_tick)
  {
  }
}

static void Capture_Reset(uint8_t sensor_id)
{
  sensorCapture[sensor_id].echo_start_us = 0U;
  sensorCapture[sensor_id].echo_pulse_us = 0U;
  sensorCapture[sensor_id].waiting_fall_edge = 0U;
  sensorCapture[sensor_id].echo_ready = 0U;
  sensorCapture[sensor_id].measurement_active = 0U;
}

static void Filter_Reset(uint8_t sensor_id)
{
  sensorFilter[sensor_id].filtered_cm = 0U;
  sensorFilter[sensor_id].has_value = 0U;
  sensorFilter[sensor_id].spike_count = 0U;
}

static void FillTimeout(distance_data_t *distance)
{
  distance->timestamp_ms = HAL_GetTick();
  distance->distance_cm = 0U;
  distance->is_object_detected = 0U;
  distance->system_status = SYSTEM_STATUS_SENSOR_TIMEOUT;
}

static void Sensor_StartMeasurement(uint8_t sensor_id)
{
  sensorCapture[sensor_id].echo_pulse_us = 0U;
  sensorCapture[sensor_id].waiting_fall_edge = 0U;
  sensorCapture[sensor_id].echo_ready = 0U;
  sensorCapture[sensor_id].measurement_active = 1U;

  HAL_GPIO_WritePin(TRig_GPIO_Port, TRig_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(trig2_GPIO_Port, trig2_Pin, GPIO_PIN_RESET);
  DelayUs(2U);
  HAL_GPIO_WritePin(sensor_pins[sensor_id].trig_port,
                    sensor_pins[sensor_id].trig_pin,
                    GPIO_PIN_SET);
  DelayUs(SENSOR_TRIGGER_PULSE_US);
  HAL_GPIO_WritePin(sensor_pins[sensor_id].trig_port,
                    sensor_pins[sensor_id].trig_pin,
                    GPIO_PIN_RESET);
}

static void Sensor_StopMeasurement(uint8_t sensor_id)
{
  sensorCapture[sensor_id].waiting_fall_edge = 0U;
  sensorCapture[sensor_id].echo_ready = 0U;
  sensorCapture[sensor_id].measurement_active = 0U;
}

static bool Sensor_Read(uint8_t sensor_id, distance_data_t *distance)
{
  sensor_capture_t *capture;

  if ((sensor_id >= SENSOR_COUNT) || (distance == NULL) || (echoSem[sensor_id] == NULL))
  {
    return false;
  }

  capture = &sensorCapture[sensor_id];
  FillTimeout(distance);

  while (xSemaphoreTake(echoSem[sensor_id], 0U) == pdPASS)
  {
  }

  Sensor_StartMeasurement(sensor_id);

  if (xSemaphoreTake(echoSem[sensor_id],
                     pdMS_TO_TICKS(SENSOR_ECHO_TIMEOUT_MS)) != pdPASS)
  {
    Sensor_StopMeasurement(sensor_id);
    FillTimeout(distance);
    return false;
  }

  distance->timestamp_ms = HAL_GetTick();

  if ((capture->echo_ready == 0U) || (capture->echo_pulse_us == 0U))
  {
    distance->distance_cm = 0U;
    distance->is_object_detected = 0U;
    distance->system_status = SYSTEM_STATUS_SENSOR_FAULT;
    Sensor_StopMeasurement(sensor_id);
    return false;
  }

  // Chuy?n d?i siêu âm b?ng s? nguyên. 
  // Công th?c: Pulse / 58 = CM. +29 d? làm tròn (Rounding) t?i uu nh?t.
  distance->distance_cm = (uint16_t)((capture->echo_pulse_us + 29U) / 58U);
  distance->is_object_detected = 1U;
  distance->system_status = SYSTEM_STATUS_OK;
  Sensor_StopMeasurement(sensor_id);
  return true;
}

static void Filter_Apply(uint8_t sensor_id, distance_data_t *distance)
{
  uint16_t sample_cm;
  sensor_filter_t *filter;

  if ((sensor_id >= SENSOR_COUNT) ||
      (distance == NULL) ||
      (distance->system_status != SYSTEM_STATUS_OK))
  {
    return;
  }

  sample_cm = distance->distance_cm;

  if (sample_cm < SENSOR_MIN_VALID_CM)
  {
    distance->distance_cm = SENSOR_MIN_VALID_CM;
    distance->is_object_detected = 1U;
    distance->system_status = SYSTEM_STATUS_SENSOR_BELOW_MIN;
    return;
  }

  if (sample_cm > SENSOR_MAX_VALID_CM)
  {
    distance->distance_cm = 0U;
    distance->is_object_detected = 0U;
    distance->system_status = SYSTEM_STATUS_SENSOR_FAULT;
    return;
  }

  filter = &sensorFilter[sensor_id];

  if (filter->has_value == 0U)
  {
    filter->filtered_cm = sample_cm;
    filter->has_value = 1U;
    filter->spike_count = 0U;
  }
  else
  {
    uint16_t delta;
    
    // Tính kho?ng cách chênh l?ch tuy?t d?i
    if (sample_cm > filter->filtered_cm) {
      delta = sample_cm - filter->filtered_cm;
    } else {
      delta = filter->filtered_cm - sample_cm;
    }

    if (delta > SENSOR_FILTER_MAX_STEP_CM)
    {
      filter->spike_count++;
      
      // N?u có 2 l?n nh?y xa/g?n liên ti?p -> V?t th? th?c s? chuy?n d?ng
      if (filter->spike_count >= 2U) 
      {
        filter->filtered_cm = sample_cm; // Nh?y th?ng (Snap) d?n giá tr? th?c
        filter->spike_count = 0U;
      }
      else
      {
        // Tr? l?i giá tr? cu vì nghi ng? dây là nhi?u gai (Spike/Noise)
        distance->distance_cm = filter->filtered_cm; 
        return; 
      }
    }
    else
    {
      // N?u thay d?i ch?m thì Reset Spike và dùng trung bình làm mu?t EMA
      filter->spike_count = 0U;
      filter->filtered_cm = (sample_cm + filter->filtered_cm) / 2U; 
    }
  }

  distance->distance_cm = filter->filtered_cm;
  distance->is_object_detected = 1U;
  distance->system_status = SYSTEM_STATUS_OK;
}

static warning_level_t PickWarningLevel(uint16_t distance_cm, system_status_t status)
{
  if (status == SYSTEM_STATUS_SENSOR_BELOW_MIN)
  {
    return WARNING_LEVEL_DANGER;
  }

  if (status != SYSTEM_STATUS_OK)
  {
    return WARNING_LEVEL_SAFE;
  }

  if (distance_cm < WARNING_DISTANCE_THRESHOLD_CM)
  {
    return WARNING_LEVEL_DANGER;
  }

  if (distance_cm <= SAFE_DISTANCE_THRESHOLD_CM)
  {
    return WARNING_LEVEL_WARNING;
  }

  return WARNING_LEVEL_SAFE;
}

static void MakeState(const distance_data_t *distance, system_state_t *state)
{
  state->timestamp_ms = distance->timestamp_ms;
  
  // Ép sang float d? tuong thích v?i c?u trúc hi?n th? bên file header
  state->distance_cm = (float)distance->distance_cm; 
  
  state->system_status = distance->system_status;
  state->is_object_detected = distance->is_object_detected;

  if ((state->system_status != SYSTEM_STATUS_OK) &&
      (state->system_status != SYSTEM_STATUS_SENSOR_BELOW_MIN))
  {
    state->distance_cm = 0.0f;
    state->is_object_detected = 0U;
  }

  state->warning_level = PickWarningLevel(distance->distance_cm, state->system_status);
}

static uint8_t StatusPriority(system_status_t status)
{
  switch (status)
  {
    case SYSTEM_STATUS_SENSOR_BELOW_MIN:
      return 4U;

    case SYSTEM_STATUS_SENSOR_TIMEOUT:
      return 3U;

    case SYSTEM_STATUS_SENSOR_FAULT:
      return 2U;

    default:
      return 0U;
  }
}

static void CombineState(void)
{
  const system_state_t *left = &sensorState[0];
  const system_state_t *right = &sensorState[1];

  combinedState.timestamp_ms =
      (left->timestamp_ms > right->timestamp_ms) ? left->timestamp_ms : right->timestamp_ms;
  combinedState.system_status =
      (StatusPriority(left->system_status) >= StatusPriority(right->system_status))
          ? left->system_status
          : right->system_status;

  if ((left->warning_level == WARNING_LEVEL_DANGER) ||
      (right->warning_level == WARNING_LEVEL_DANGER))
  {
    combinedState.warning_level = WARNING_LEVEL_DANGER;
  }
  else if ((left->warning_level == WARNING_LEVEL_WARNING) ||
           (right->warning_level == WARNING_LEVEL_WARNING))
  {
    combinedState.warning_level = WARNING_LEVEL_WARNING;
  }
  else
  {
    combinedState.warning_level = WARNING_LEVEL_SAFE;
  }

  combinedState.is_object_detected =
      (uint8_t)((left->is_object_detected != 0U) ||
                (right->is_object_detected != 0U));

  if ((left->system_status == SYSTEM_STATUS_OK) &&
      (right->system_status == SYSTEM_STATUS_OK))
  {
    combinedState.distance_cm =
        (left->distance_cm < right->distance_cm) ? left->distance_cm : right->distance_cm;
  }
  else if (left->system_status == SYSTEM_STATUS_OK)
  {
    combinedState.distance_cm = left->distance_cm;
  }
  else if (right->system_status == SYSTEM_STATUS_OK)
  {
    combinedState.distance_cm = right->distance_cm;
  }
  else
  {
    combinedState.distance_cm = 0.0f;
  }
}

static void InitDefaultState(void)
{
  distance_data_t timeout_distance;
  uint8_t i;

  FillTimeout(&timeout_distance);

  for (i = 0U; i < SENSOR_COUNT; i++)
  {
    MakeState(&timeout_distance, &sensorState[i]);
  }

  CombineState();
}

static void PublishDisplay(void)
{
  display_message_t message;

  message.sensor[0] = sensorState[0];
  message.sensor[1] = sensorState[1];
  (void)xQueueOverwrite(displayQueue, &message);
}

static void ProcessSensorMessage(const sensor_message_t *message)
{
  distance_data_t distance;

  if ((message == NULL) || (message->sensor_id >= SENSOR_COUNT))
  {
    return;
  }

  distance = message->distance;

  if (distance.system_status == SYSTEM_STATUS_OK)
  {
    Filter_Apply(message->sensor_id, &distance);
  }

  MakeState(&distance, &sensorState[message->sensor_id]);
  CombineState();
}

static uint8_t LedShouldBeOn(const system_state_t *state, uint32_t tick_ms)
{
  if (state->system_status == SYSTEM_STATUS_SENSOR_BELOW_MIN)
  {
    return 1U;
  }

  if (state->system_status != SYSTEM_STATUS_OK)
  {
    return (uint8_t)(((tick_ms / ALERT_ERROR_BLINK_MS) % 2U) != 0U);
  }

  if (state->warning_level == WARNING_LEVEL_DANGER)
  {
    return 1U;
  }

  if (state->warning_level == WARNING_LEVEL_WARNING)
  {
    return (uint8_t)(((tick_ms / ALERT_WARNING_BLINK_MS) % 2U) != 0U);
  }

  return 0U;
}

static uint8_t BuzzerShouldBeOn(const system_state_t *state, uint32_t tick_ms)
{
  uint32_t pattern_tick;

  if (state->system_status == SYSTEM_STATUS_SENSOR_BELOW_MIN)
  {
    return 1U;
  }

  if (state->system_status != SYSTEM_STATUS_OK)
  {
    return (uint8_t)(((tick_ms / ALERT_ERROR_BLINK_MS) % 2U) != 0U);
  }

  if (state->warning_level == WARNING_LEVEL_DANGER)
  {
    return 1U;
  }

  if (state->warning_level == WARNING_LEVEL_WARNING)
  {
    pattern_tick = tick_ms % ALERT_WARNING_BEEP_PERIOD_MS;
    return (uint8_t)(pattern_tick < ALERT_WARNING_BEEP_WINDOW_MS);
  }

  return 0U;
}

static void UpdateWarningOutputs(void)
{
  uint32_t tick_ms = HAL_GetTick();

  HAL_GPIO_WritePin(led_GPIO_Port,
                    led_Pin,
                    LedShouldBeOn(&sensorState[0], tick_ms) ? GPIO_PIN_SET : GPIO_PIN_RESET);
  HAL_GPIO_WritePin(led2_GPIO_Port,
                    led2_Pin,
                    LedShouldBeOn(&sensorState[1], tick_ms) ? GPIO_PIN_SET : GPIO_PIN_RESET);
  HAL_GPIO_WritePin(buzz_GPIO_Port,
                    buzz_Pin,
                    BuzzerShouldBeOn(&combinedState, tick_ms) ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

static void Board_InitApplication(void)
{
  uint8_t i;

  DelayCounter_Init();

  for (i = 0U; i < SENSOR_COUNT; i++)
  {
    Capture_Reset(i);
    Filter_Reset(i);
  }

  InitDefaultState();

  HAL_GPIO_WritePin(led_GPIO_Port, led_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(led2_GPIO_Port, led2_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(buzz_GPIO_Port, buzz_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(TRig_GPIO_Port, TRig_Pin, GPIO_PIN_RESET);
  HAL_GPIO_WritePin(trig2_GPIO_Port, trig2_Pin, GPIO_PIN_RESET);
  (void)lcd_display_init();
}

static void SensorTask(void *argument)
{
  sensor_message_t message;
  uint8_t sensor_id;

  (void)argument;
  vTaskDelay(pdMS_TO_TICKS(SENSOR_STARTUP_DELAY_MS));

  for (;;)
  {
    (void)xSemaphoreTake(sampleSem, portMAX_DELAY);

    for (sensor_id = 0U; sensor_id < SENSOR_COUNT; sensor_id++)
    {
      message.sensor_id = sensor_id;
      (void)Sensor_Read(sensor_id, &message.distance);

      if (xQueueSendToBack(sensorQueue, &message, pdMS_TO_TICKS(5U)) == pdPASS)
      {
        (void)xEventGroupSetBits(appEvents, EVENT_SENSOR_DATA);
      }

      if (sensor_id == 0U)
      {
        vTaskDelay(pdMS_TO_TICKS(SENSOR_INTER_SAMPLE_GAP_MS));
      }
    }
  }
}

static void WarningTask(void *argument)
{
  EventBits_t events;
  sensor_message_t message;

  (void)argument;
  InitDefaultState();
  PublishDisplay();
  UpdateWarningOutputs();

  for (;;)
  {
    events = xEventGroupWaitBits(appEvents,
                                 EVENT_SENSOR_DATA | EVENT_ALERT_TICK,
                                 pdTRUE,
                                 pdFALSE,
                                 portMAX_DELAY);

    if ((events & EVENT_SENSOR_DATA) != 0U)
    {
      while (xQueueReceive(sensorQueue, &message, 0U) == pdPASS)
      {
        ProcessSensorMessage(&message);
      }

      PublishDisplay();
    }

    UpdateWarningOutputs();
  }
}

static void DisplayTask(void *argument)
{
  display_message_t message;

  (void)argument;

  for (;;)
  {
    if (xQueueReceive(displayQueue, &message, portMAX_DELAY) == pdPASS)
    {
      if (xSemaphoreTake(lcdMutex, pdMS_TO_TICKS(20U)) == pdPASS)
      {
        lcd_display_show_state(&message.sensor[0], &message.sensor[1]);
        xSemaphoreGive(lcdMutex);
      }
    }
  }
}

static void SampleTimerCallback(TimerHandle_t timer)
{
  (void)timer;
  (void)xSemaphoreGive(sampleSem);
}

static void AlertTimerCallback(TimerHandle_t timer)
{
  (void)timer;
  (void)xEventGroupSetBits(appEvents, EVENT_ALERT_TICK);
}

static void HandleEchoEdgeFromIsr(uint16_t gpio_pin)
{
  uint8_t sensor_id;
  uint32_t now_us;
  BaseType_t higher_priority_woken = pdFALSE;
  sensor_capture_t *capture;

  if (gpio_pin == Echo_Pin)
  {
    sensor_id = 0U;
  }
  else if (gpio_pin == echo2_Pin)
  {
    sensor_id = 1U;
  }
  else
  {
    return;
  }

  capture = &sensorCapture[sensor_id];

  if (capture->measurement_active == 0U)
  {
    return;
  }

  now_us = GetMicroseconds();

  if (HAL_GPIO_ReadPin(sensor_pins[sensor_id].echo_port,
                       sensor_pins[sensor_id].echo_pin) == GPIO_PIN_SET)
  {
    capture->echo_start_us = now_us;
    capture->waiting_fall_edge = 1U;
    return;
  }

  if (capture->waiting_fall_edge == 0U)
  {
    return;
  }

  capture->echo_pulse_us = now_us - capture->echo_start_us;
  capture->waiting_fall_edge = 0U;
  capture->echo_ready = 1U;

  xSemaphoreGiveFromISR(echoSem[sensor_id], &higher_priority_woken);
  portYIELD_FROM_ISR(higher_priority_woken);
}

void HAL_GPIO_EXTI_Callback(uint16_t gpio_pin)
{
  HandleEchoEdgeFromIsr(gpio_pin);
}
