typedef struct
{
  uint32_t timestamp_ms;
  uint16_t distance_cm; // Chuy?n sang dùng s? nguyên uint16_t
  uint8_t is_object_detected;
  system_status_t system_status;
} distance_data_t;

typedef struct
{
  uint8_t sensor_id;
  distance_data_t distance;
} sensor_message_t;

typedef struct
{
  system_state_t sensor[2];
} display_message_t;

typedef struct
{
  GPIO_TypeDef *trig_port;
  uint16_t trig_pin;
  GPIO_TypeDef *echo_port;
  uint16_t echo_pin;
} sensor_pin_t;

typedef struct
{
  volatile uint32_t echo_start_us;
  volatile uint32_t echo_pulse_us;
  volatile uint8_t waiting_fall_edge;
  volatile uint8_t echo_ready;
  volatile uint8_t measurement_active;
} sensor_capture_t;

typedef struct
{
  uint16_t filtered_cm; // Chuy?n sang s? nguyên
  uint8_t has_value;
  uint8_t spike_count;  // Thêm bi?n d?m s? l?n d?t bi?n d? ch?t giá tr? nhanh (Snap)
} sensor_filter_t;
